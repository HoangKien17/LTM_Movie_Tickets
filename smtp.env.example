# Append these keys to the existing .env ON THE SERVER.
# Preserve MOVIE_DB_* and PAYMENT_* settings already in that file.
# Do not put a real Gmail password or App Password in this example file.
MOVIE_SMTP_HOST=smtp.gmail.com
MOVIE_SMTP_USER=your-sender@gmail.com
MOVIE_SMTP_APP_PASSWORD=your_16_character_google_app_password
