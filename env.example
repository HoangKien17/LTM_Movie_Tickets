MOVIE_DB_URL=jdbc:mysql://127.0.0.1:3306/movie_tickets_ltm
MOVIE_DB_USER=root
MOVIE_DB_PASSWORD=
MOVIE_SERVER_PORT=2040
MOVIE_HTTP_PORT=8080

# Cấu hình xem vé từ xa bằng 4G/5G qua Ngrok / Cloudflare Tunnel
# Ví dụ: PUBLIC_TICKET_URL=https://abcxyz.ngrok-free.app
# Nếu để trống, hệ thống sẽ tự động dùng địa chỉ IP Wi-Fi nội bộ
PUBLIC_TICKET_URL=

# demo: không chuyển tiền; payos: giao dịch thật vào tài khoản liên kết với payOS
PAYMENT_MODE=demo
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=https://payos.vn
PAYOS_CANCEL_URL=https://payos.vn
